# Copia este archivo a .env antes de `docker-compose up`.
# Nada de esto son secretos reales -- son valores de demo para el
# entorno local con Mailhog. En producción, todo esto viene de un
# vault (ver ARQUITECTURA.md).

# --- Sesión / cookies ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_MAX_AGE_SECONDS=1800
COOKIE_SECURE=false

# --- Base de datos ---
DATABASE_URL=sqlite:////srv/data/secops.db

# --- Cuentas semilla (solo se crean si la tabla users está vacía) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CambiaEstaAdmin123!
SEED_USER_USERNAME=usuario
SEED_USER_PASSWORD=CambiaEstaUser123!

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute
SCAN_RATE_LIMIT=10/minute

# --- Logging ---
LOG_FILE=/srv/logs/audit.log

# --- Conector de correo (Mailhog en docker-compose, sin credenciales) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=secops-alerts@localhost

# --- Conector webhook genérico (Slack-compatible) ---
ALERT_WEBHOOK_URL=
